<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.nearpush.daemon</string>
  <key>ProgramArguments</key>
  <array><string>@HOME@/.local/bin/nearpushd</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/nearpush/nearpushd.out.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/nearpush/nearpushd.err.log</string>
</dict>
</plist>
